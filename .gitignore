# Nix build/result symlinks
result
result-*

# Editor
*.swp
*.swo
*~

# direnv
.direnv/
.envrc.local

# Claude Code — per-machine local settings only; shared config under
# .claude/ (e.g. settings.json, custom commands) is still meant to be committed.
.claude/settings.local.json

# Secrets — only agenix's encrypted .age files and its rules file
# (secrets/secrets.nix) are meant to be committed. Never commit plaintext.
*.secret
secrets/*
!secrets/*.nix
!secrets/*.age
!secrets/README.md
